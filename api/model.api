syntax = "v1"

// 数据模型，对应《默认模块.md》的数据模型部分。
// 除数据模型外，多个模块共用的响应结构（如视频列表的包装）也放在这里。

// 响应状态
type Status {
	Code int32  `json:"code"` // 状态码
	Msg  string `json:"msg"`  // 提示信息
}

// 用户
type User {
	Id        int64  `json:"id"`         // ID 编号
	Username  string `json:"username"`   // 用户名
	Password  string `json:"password"`   // 密码
	AvatarUrl string `json:"avatar_url"` // 头像链接地址
	CreateAt  string `json:"create_at"`  // 创建时间
	UpdatedAt string `json:"updated_at"` // 更新时间
	DeleteAt  string `json:"delete_at"`  // 软删除时间
}

// MFA 二维码
type MFAQrcode {
	Secret string `json:"secret"` // mfa 密钥
	Qrcode string `json:"qrcode"` // base64 编码后的 qrcode
}

// 视频
type Video {
	Id           int64  `json:"id"`            // ID 编号
	UserId       int64  `json:"user_id"`       // 视频作者 id
	VideoUrl     string `json:"video_url"`     // 视频链接
	CoverUrl     string `json:"cover_url"`     // 封面链接
	Title        string `json:"title"`         // 视频标题
	Description  string `json:"description"`   // 视频描述
	VisitCount   int64  `json:"visit_count"`   // 观看量
	LikeCount    int64  `json:"like_count"`    // 点赞量
	CommentCount int64  `json:"comment_count"` // 评论数
	CreatedAt    string `json:"created_at"`    // 创建时间
	UpdatedAt    string `json:"updated_at"`    // 更新时间
	DeleteAt     string `json:"delete_at"`     // 删除时间
}

// 评论
type Comment {
	Id         int64  `json:"id"`          // ID 编号
	UserId     int64  `json:"user_id"`     // 发布者用户 id
	VideoId    int64  `json:"video_id"`    // 视频 id
	ParentId   int64  `json:"parent_id"`   // 父评论 id，可留空
	LikeCount  int64  `json:"like_count"`  // 点赞数
	ChildCount int64  `json:"child_count"` // 子评论数
	Content    string `json:"content"`     // 评论文本本身
	CreatedAt  string `json:"created_at"`  // 创建时间
	UpdatedAt  string `json:"updated_at"`  // 更新时间
	DeletedAt  string `json:"deleted_at"`  // 删除时间
}

// 分页视频数据，查看用户视频、搜索视频、点赞列表返回总数
type VideoPageData {
	Items []Video `json:"items"` // 视频列表
	Total int64   `json:"total"` // 总数
}

// 视频流数据，首页视频流、热门排行榜不返回总数
type VideoFeedData {
	Items []Video `json:"items"` // 视频列表
}

// 用户简要信息，关注/粉丝/好友列表用
type UserBrief {
	Id       int64  `json:"id"`       // ID 编号
	Username string `json:"username"` // 用户名
}

// 用户简要信息分页数据
type UserBriefPageData {
	Items []UserBrief `json:"items"` // 用户列表
	Total int64       `json:"total"` // 总数
}
