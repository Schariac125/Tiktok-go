# 自动识别文本文件
* text=auto

# Go 代码
*.go text eol=lf

# Go 模块文件
go.mod text eol=lf
go.sum text eol=lf

# Docker 相关文件
Dockerfile text eol=lf
.dockerignore text eol=lf

# 配置文件
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.ini text eol=lf

# 文档和脚本
*.md text eol=lf
*.sh text eol=lf
*.sql text eol=lf

# Windows 脚本
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary