# tiktok-go 的环境变量模板。
#
# 用法：cp .env.example .env，按需修改。
#   - .env 已在 .gitignore 里，不会被提交；这个模板文件要提交。
#   - 本地开发：服务启动时会自动读取项目根目录的 .env。
#   - 容器模式：docker compose 会自动读取同目录的 .env 并注入到各容器。
#
# 这里出现的变量名都被 config 文件以 ${VAR} 的形式引用，
# 缺一个服务就会在启动时直接报出变量名，而不是带着空值跑起来。

# ---- MySQL ----
# compose 里的 MYSQL_ROOT_PASSWORD、healthcheck，以及各服务 yaml 中
# DataSource 的 ${MYSQL_ROOT_PASSWORD} 共用这一个值，改这里即可全部生效。
# 生产环境请换成强密码。
MYSQL_ROOT_PASSWORD=

# ---- JWT ----
# 签名密钥。user.rpc 签发 token、gateway 校验 token，两边必须一致——
# 外置成一个变量后天然一致；此前是两处字面量靠人工同步，
# 改一处漏一处会直接导致网关验不过 user 签发的 token。
# 生产环境请换成足够长的随机串。
JWT_ACCESS_SECRET=

# ---- 阿里云 OSS ----
# 投稿视频与头像的对象存储凭据。
# 留空不影响服务启动，只是走到上传接口时会失败；要用上传功能再填。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
